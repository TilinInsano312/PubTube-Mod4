# Local configuration for the PubTube API Gateway.
# Copy this file to .env or export the variables in your shell.

GATEWAY_PORT=8000
GATEWAY_ENVIRONMENT=local
DASHBOARD_URL=http://localhost:8004
# Internal service DNS names on the shared pubtube-network Docker network.
# When running a module outside Docker, override these with reachable URLs.
MODULE1_URL=http://module1-api:8000
MODULE2_URL=http://module2-api:8002
MODULE3_URL=http://module3-api:8003

# Explicit HTTP client timeouts for future upstream calls.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_READ_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=300
UPSTREAM_POOL_TIMEOUT_SECONDS=5

# Fixed-window in-memory rate limiting per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional comma-separated IPs/CIDRs allowed to provide X-Real-IP.
# Leave empty unless the Gateway is behind a trusted reverse proxy.
TRUSTED_PROXY_IPS=

# Set this to the secret used by the trusted JWT issuer.
JWT_SECRET=
JWT_ALGORITHM=HS256

# OpenTelemetry tracing. Keep the exporter disabled for a standalone local
# Gateway; Docker Compose overrides this to send traces to the local collector.
OTEL_SERVICE_NAME=module4-gateway
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=
