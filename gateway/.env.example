# Local configuration for the PubTube API Gateway.
# Copy this file to .env or export the variables in your shell.

GATEWAY_PORT=8000
# Origin of Module 1; the Gateway appends the contracted /api/content path.
# Override this with the reachable Docker-network hostname and port.
MODULE1_URL=http://localhost:8001
MODULE2_URL=http://localhost:8002
MODULE3_URL=http://localhost:8003

# Explicit HTTP client timeouts for future upstream calls.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_READ_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=300
UPSTREAM_POOL_TIMEOUT_SECONDS=5

# Fixed-window in-memory rate limiting per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional comma-separated IPs/CIDRs allowed to provide X-Real-IP.
# Leave empty unless the Gateway is behind a trusted reverse proxy.
TRUSTED_PROXY_IPS=

# Set this to the secret used by the trusted JWT issuer.
JWT_SECRET=
JWT_ALGORITHM=HS256
